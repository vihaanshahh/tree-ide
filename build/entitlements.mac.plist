<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs JIT + writable/executable memory for V8. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- node-pty / tree-sitter load unsigned native .node modules at runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Allow DYLD_* env vars some child processes (shells, CLIs) rely on. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Inherited by child processes spawned via posix_spawn (the terminal). -->
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
