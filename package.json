{
  "name": "tree-ide",
  "productName": "Tree",
  "version": "0.3.1",
  "description": "Tree — a graph-first IDE (long: Tree IDE) that maps any repo into a live blueprint and runs agents alongside it.",
  "main": "main.js",
  "type": "commonjs",
  "bin": {
    "tree-ide": "./bin/tree-ide.js",
    "treeide": "./bin/tree-ide.js",
    "tree-ide-server": "./bin/tree-ide-server.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "serve": "node ./bin/tree-ide-server.js",
    "test": "node tests/scanner-smoke.js",
    "test:renderer": "electron --disable-gpu --no-sandbox tests/renderer-smoke.js",
    "postinstall": "node ./scripts/postinstall.js",
    "build:icon": "node scripts/build-icns.js",
    "dist": "npm run build:icon && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:arm64": "npm run build:icon && electron-builder --mac dmg --arm64 --publish never",
    "dist:x64": "npm run build:icon && electron-builder --mac dmg --x64 --publish never",
    "dist:universal": "npm run build:icon && electron-builder --mac dmg --universal --publish never",
    "dist:win": "npm run build:icon && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "ai.fluidstate.tree",
    "productName": "Tree",
    "copyright": "Copyright © 2026 Vihaan Shah",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**/*",
      "src/**/*",
      "bin/**/*",
      "scripts/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Tree ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tree-Setup-${version}.exe",
      "shortcutName": "Tree"
    }
  },
  "author": "Vihaan Shah",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "ignore": "^5.3.2",
    "node-pty": "^1.1.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1"
  }
}
