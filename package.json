{
  "name": "tree-ide",
  "productName": "Tree",
  "version": "0.2.0",
  "description": "Tree — a graph-first IDE (long: Tree IDE) that maps any repo into a live blueprint and runs agents alongside it.",
  "main": "main.js",
  "type": "commonjs",
  "bin": {
    "tree-ide": "./bin/tree-ide.js",
    "treeide": "./bin/tree-ide.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "author": "Vihaan Shah",
  "license": "MIT",
  "dependencies": {
    "@electron/rebuild": "^4.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "electron": "^33.0.0",
    "ignore": "^5.3.2",
    "node-pty": "^1.1.0"
  }
}
